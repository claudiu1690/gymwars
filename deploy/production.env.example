# Copy values into the hosting provider's private environment settings.
# Do not commit real credentials. PUBLIC_URL must be the actual hosting origin;
# use the staging HTTPS origin first, then the custom domain after DNS is ready.
NODE_ENV=production
LOCAL_MODE=false
PUBLIC_URL=https://gymwars.groundandpound.net
PORT=8080

# Authenticated external database, with an explicit database name.
MONGODB_URI=
# Private stable random secret, at least 32 characters.
JWT_SECRET=

# Real transactional email and support inbox; required before public startup.
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
# Public plain-text service disclosure, completed after providers, regions,
# email retention and backup arrangements are confirmed and reviewed.
PUBLIC_SERVICE_DETAILS=

DISABLE_SCHEDULER=true
SHOP_PREVIEW_ENABLED=false
# Leave TIME_WARP unset. Payments remain disconnected.
