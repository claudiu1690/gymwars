# ── Local dev master switch ──
# true = force local Mongo + Redis regardless of other URLs. Leave unset on
# deployed hosts so platform-provided MONGODB_URI / REDIS_URL take effect.
LOCAL_MODE=true

# ── Databases ──
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/gymWars
# MONGODB_URI=            # injected by host in prod
REDIS_URL_LOCAL=redis://127.0.0.1:6379
# REDIS_URL=              # injected by host in prod

# ── Auth ──
JWT_SECRET=change_me_in_prod

# ── URLs ──
APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:4101
# FRONTEND_URL=           # deployed frontend origin(s), comma-separated

# ── Email (optional — console fallback when unset) ──
# RESEND_API_KEY=
# EMAIL_FROM=Gym Wars <noreply@yourdomain.com>

# ── Dev time warp (LOCAL_MODE only): game-weeks pass N× faster ──
# TIME_WARP=24

# Player-paced careers do not use Redis, TIME_WARP, or wall-clock advancement.
# Career weeks and ranked cards refill on a persisted server-only 24-hour
# schedule. Refills never play weeks, charge upkeep, or resolve training.
# The optional real-time comparison mode requires a MongoDB replica set.
# Its UI also requires VITE_ENABLE_REALTIME_COMPARISON=true in a DEV Vite build.
# DISABLE_SCHEDULER=true  # useful for career-only local development

# Optional Gym Wars scoring experiment. Leave unset for total-points seasons.
# Set an exact unopened FUTURE season ID before its start, e.g. gym-wars-2.
# A stored season rule stays frozen even if this setting is later removed.
# Existing and current seasons are never recalculated by this experiment.
# GYMWARS_BEST_TEN_SEASON=
# Enables simulated cosmetic purchases only in non-production LOCAL_MODE.
# No payment provider is connected. Keep disabled on public environments.
SHOP_PREVIEW_ENABLED=false

# Persistent local staging (separate from the seeded preview):
# STAGING_JWT_SECRET=    # private stable value, at least 32 characters
# STAGING_INSTANCE=default
# STAGING_API_PORT=4116
# STAGING_WEB_PORT=5196
# SUPPORT_EMAIL=        # optional operator contact, not a simulated inbox
# Production requires JWT_SECRET; security email cannot fall back to console.
