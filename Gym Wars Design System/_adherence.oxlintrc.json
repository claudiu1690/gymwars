{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo Black|Inter|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo Black, Inter, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|icon|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, icon, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|tint)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'tint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FighterStats'] > JSXAttribute > JSXIdentifier[name!=/^(?:striking|grappling|submissions|conditioning|key|ref|className|style|children)$/]",
        "message": "<FighterStats> doesn't accept that prop. Declared props: striking, grappling, submissions, conditioning."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatRanges'] > JSXAttribute > JSXIdentifier[name!=/^(?:striking|grappling|submissions|conditioning|key|ref|className|style|children)$/]",
        "message": "<StatRanges> doesn't accept that prop. Declared props: striking, grappling, submissions, conditioning."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|size|showLabel|key|ref|className|style|children)$/]",
        "message": "<StatBar> doesn't accept that prop. Declared props: label, value, size, showLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<StatBar> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|countdown|size|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: status, countdown, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:in-camp|fight-ready|fatigued|shielded|retiring)$/]",
        "message": "<StatusChip> status must be one of 'in-camp' | 'fight-ready' | 'fatigued' | 'shielded' | 'retiring'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<StatusChip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StyleBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|showFamily|key|ref|className|style|children)$/]",
        "message": "<StyleBadge> doesn't accept that prop. Declared props: style, showFamily."
      },
      {
        "selector": "JSXOpeningElement[name.name='StyleBadge'] > JSXAttribute[name.name='style'] > Literal[value!=/^(?:boxer|muay-thai|wrestler|judo|mma|bjj)$/]",
        "message": "<StyleBadge> style must be one of 'boxer' | 'muay-thai' | 'wrestler' | 'judo' | 'mma' | 'bjj'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimerBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|urgent|complete|size|label|key|ref|className|style|children)$/]",
        "message": "<TimerBadge> doesn't accept that prop. Declared props: value, urgent, complete, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimerBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<TimerBadge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeightClassChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:weightClass|variant|key|ref|className|style|children)$/]",
        "message": "<WeightClassChip> doesn't accept that prop. Declared props: weightClass, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeightClassChip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:short|full)$/]",
        "message": "<WeightClassChip> variant must be one of 'short' | 'full'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
