{
  "name": "gym-wars",
  "version": "1.0.0-rc.1",
  "description": "Gym Wars — MMA gym management browser game backend",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "start:local": "cross-env LOCAL_MODE=true node app.js",
    "dev": "node --watch app.js",
    "dev:local": "cross-env LOCAL_MODE=true node --watch app.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node scripts/runE2E.cjs",
    "test:e2e:report": "playwright show-report output/e2e/report",
    "test:db": "cross-env GYMWARS_DB_TESTS=1 node --test tests/database.integration.test.js tests/standalone.integration.test.js tests/careerAllowances.integration.test.js tests/careerWarLeague.integration.test.js",
    "validate:career": "node scripts/validateCareer.js 10000",
    "preview:career": "node scripts/previewCareer.js",
    "staging:local": "node scripts/localStaging.js",
    "validate:alpha": "node scripts/validateAlphaPacing.js",
    "report:alpha": "node scripts/alphaReport.js",
    "validate:supplies": "node scripts/simulateSupplyPacing.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "mma",
    "management",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "5.76.6",
    "compression": "1.8.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9"
  }
}
